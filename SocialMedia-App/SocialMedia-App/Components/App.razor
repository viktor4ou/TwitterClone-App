<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.BlazorLayout)">
                <NotAuthorized>
                    <div class="container mt-5 text-center">
                        <h3>Access Denied</h3>
                        <p>Please <a href="/Identity/Account/Login">log in</a> to access this page.</p>
                    </div>
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(Layout.BlazorLayout)">
                <div class="container mt-5 text-center">
                    <h3>Page Not Found</h3>
                    <p>The page you are looking for does not exist.</p>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
